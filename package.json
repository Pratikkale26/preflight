    "format:check": "prettier --check .",
    "verify": "pnpm typecheck && pnpm format:check && pnpm test"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
